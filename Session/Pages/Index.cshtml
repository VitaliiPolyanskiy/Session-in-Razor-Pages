@page
@model Session.Pages.IndexModel

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="utf-8" />
    <title>Головна</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <div class="card shadow-sm p-4">
                    <h2 class="mb-4">Вітаємо, @HttpContext.Session.GetString("login")!</h2>

                    <form method="post" class="mb-3">
                        <button type="submit" class="btn btn-danger w-100">Вийти</button>
                    </form>

                    <div>
                        <a href="/Create" class="text-decoration-none">На сторінку авторизації</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>